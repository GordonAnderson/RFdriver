# PlatformIO build output and downloaded library dependencies - regenerated
# by `pio run`, never worth committing.
.pio

# Machine-specific VS Code / PlatformIO IDE files.
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# macOS Finder cruft.
.DS_Store

# firmware/*.bin is intentionally NOT ignored - those are the versioned
# release images publish_firmware.py produces, used by the PGM field-update
# command and as known-good recovery images (see firmware/README.md).
